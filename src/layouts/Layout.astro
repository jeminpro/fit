---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Fit' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Track body measurements and daily habits for you and your family." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="mask-icon" href={`${base}safari-pinned-tab.svg`} color="#E32E3B" />
    <meta name="theme-color" content="#090e1a" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
